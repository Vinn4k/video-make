# Copie para .env e preencha só o que for usar.

# Roteiro (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Narração e música locais: ComfyUI no PC da GPU (ChatterBox + ACE-Step)
COMFY_URL=http://127.0.0.1:8188
# Serviço de análise com Whisper (services/analysis do ia-editor), confere a fala
ANALISE_URL=http://127.0.0.1:3335

# Narração paga (alternativa ao ComfyUI)
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# Mídia grátis (sem nenhuma, usa só Wikimedia Commons)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Gemini TTS (Generate Speech do Google AI Studio): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# opcional: chave de um projeto SEM faturamento; a voz usa a cota grátis dela primeiro e depois a GEMINI_API_KEY (paga)
GEMINI_API_KEY_GRATIS=
# avisos no celular (vídeo pronto, etapa parada, pergunta do Claude sem resposta): crie o bot no @BotFather,
# mande uma mensagem para ele e pegue o chat id em https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
